# Use with: idf.py -B build-qemu -D SDKCONFIG_DEFAULTS="profiles/sdkconfig.defaults;profiles/sdkconfig.defaults.qemu" set-target esp32c3
CONFIG_PRG32_DISPLAY_QEMU_RGB=y
CONFIG_PRG32_PINS_CONFIGURED=y
CONFIG_PRG32_PIN_PROFILE_NAME="qemu"
CONFIG_PRG32_QEMU_FAIL_ON_REAL_HW=y
CONFIG_PRG32_QEMU_UART_INPUT=y
CONFIG_PRG32_CART_RAM_LARGE_128=y
CONFIG_PRG32_CART_MAX_KIB=128
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PRG32_AUDIO_ENABLED=y
CONFIG_PRG32_AUDIO_SAMPLE_RATE=22050
CONFIG_PRG32_AUDIO_MODE_MONO=y
CONFIG_PRG32_AUDIO_MAX_VOICES=8
CONFIG_PRG32_SPLASH_ENABLED=y
CONFIG_PRG32_SPLASH_DURATION_MS=900
CONFIG_PRG32_AUDIO_I2S_BCLK_GPIO=-1
CONFIG_PRG32_AUDIO_I2S_LRCLK_GPIO=-1
CONFIG_PRG32_AUDIO_I2S_DATA_GPIO=-1
CONFIG_PRG32_AUDIO_I2S_SD_GPIO=-1
# Multiplayer reaches the network through QEMU's emulated OpenCores Ethernet.
# 10.0.2.2 is the computer running QEMU; see docs/usage/network.md. A full room
# delivers a burst of peer snapshots at once: eight receive buffers hold it.
CONFIG_ETH_USE_OPENETH=y
CONFIG_ETH_OPENETH_DMA_RX_BUFFER_NUM=8
CONFIG_ETH_OPENETH_DMA_TX_BUFFER_NUM=1
CONFIG_PRG32_MULTIPLAYER_SERVER_URL="ws://10.0.2.2:8081"
