# PRG32 Hardware Pin Profile: Prototype 2 (Analog Joystick & New Harness)
CONFIG_PRG32_PIN_PROFILE_PROTOTYPE2=y
CONFIG_PRG32_PINS_CONFIGURED=y
CONFIG_PRG32_PIN_PROFILE_NAME="prototype2"

# Display (ILI9341 SPI TFT)
CONFIG_PRG32_PIN_LCD_MOSI=7
CONFIG_PRG32_PIN_LCD_MISO=2
CONFIG_PRG32_PIN_LCD_SCLK=6
CONFIG_PRG32_PIN_LCD_CS=3
CONFIG_PRG32_PIN_LCD_DC=10
CONFIG_PRG32_PIN_LCD_RST=11
CONFIG_PRG32_PIN_LCD_BL=5

# SD Card (Reserved CS)
CONFIG_PRG32_PIN_SDCARD_CS=9

# Joystick (Analog 2-Axis ADC Potentiometer)
CONFIG_PRG32_JOYSTICK_ANALOG=y
CONFIG_PRG32_PIN_JOYSTICK_X=0
CONFIG_PRG32_PIN_JOYSTICK_Y=1
CONFIG_PRG32_JOYSTICK_ADC_LEFT_THRESHOLD=1300
CONFIG_PRG32_JOYSTICK_ADC_RIGHT_THRESHOLD=2800
CONFIG_PRG32_JOYSTICK_ADC_UP_THRESHOLD=1300
CONFIG_PRG32_JOYSTICK_ADC_DOWN_THRESHOLD=2800

# Pushbuttons (Active Low to GND)
CONFIG_PRG32_PIN_BTN_START=20
CONFIG_PRG32_PIN_BTN_A=18
CONFIG_PRG32_PIN_BTN_B=19
CONFIG_PRG32_PIN_SETUP=-1

# Audio (I2S MAX98357A)
CONFIG_PRG32_AUDIO_I2S_BCLK_GPIO=4
CONFIG_PRG32_AUDIO_I2S_LRCLK_GPIO=15
CONFIG_PRG32_AUDIO_I2S_DATA_GPIO=23
CONFIG_PRG32_AUDIO_I2S_SD_GPIO=-1

# Optional Peripherals
CONFIG_PRG32_PIN_BUZZER=-1
CONFIG_PRG32_PIN_RGB_LED=-1
